# WhatsApp group JIDs from the private hosting logs; both must end with @g.us.
REQUEST_GROUP_JID=
MOVIE_GROUP_JID=

# Chama CineSubz API. When set, the bot uses Chama for search and movie details first.
# Create/revoke keys in Chama's Developer Console. Never commit your real key.
CHAMA_CINESUBZ_API_KEY=

# Optional legacy MovieBox Worker fallback.
# Use your Cloudflare Worker base URL without a trailing slash or /search.
MOVIEBOX_API_URL=
# Must match the MOVIEBOX_SECRET configured in your Cloudflare Worker. Never commit its value.
MOVIEBOX_SECRET=

# Optional JSON map: normalized movie title OR exact SinhalaSub movie-page URL ->
# direct HTTPS URL for a file you own or are authorized to distribute.
# Example: {"my authorized film":"https://your-storage.example/my-film.mp4"}
AUTHORIZED_MEDIA_MAP={}

# Logger level: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info
