# Add both WhatsApp group JIDs in your hosting service's environment settings.
# If either value is empty, the bot logs observed group JIDs but does not process requests.
REQUEST_GROUP_JID=
MOVIE_GROUP_JID=

# Optional JSON map: normalized movie title OR exact SinhalaSub movie-page URL ->
# direct HTTPS file URL for a file you own or are authorized to distribute.
# Example: {"avatar 2009":"https://your-storage.example/avatar.mp4"}
AUTHORIZED_MEDIA_MAP={}

# Logger level: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info
